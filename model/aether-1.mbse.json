      "id": "req-mis-001",
      "name": "Coastal image quality",
      "kind": "requirement",
      "ownerId": "pkg-requirements",
      "reqId": "REQ-MIS-001",
      "priority": "high",
      "status": "approved",
      "text": "The observatory shall image coastal water at a ground sample distance of 15 m or finer from a 500 km sun-synchronous orbit."
    },
    {
      "id": "req-sys-001",
      "name": "Wet mass",
      "kind": "requirement",
      "ownerId": "pkg-requirements",
      "reqId": "REQ-SYS-001",
      "priority": "high",
      "status": "approved",
      "text": "The wet mass of Aether-1 shall not exceed 4.0 kg at launch.",
      "measure": {
        "property": "mass",
        "op": "<=",
        "value": 4,
        "unit": "kg"
      }
    },
    {
      "id": "req-sys-002",
      "name": "Orbit-average power",
      "kind": "requirement",
      "ownerId": "pkg-requirements",
      "reqId": "REQ-SYS-002",
      "priority": "high",
      "status": "approved",
      "text": "Orbit-average power consumption of the bus shall not exceed 8.0 W.",
      "measure": {
        "property": "powerDraw",
        "op": "<=",
        "value": 8,
        "unit": "W"
      }
    },
    {
      "id": "req-sys-003",
      "name": "Dispenser envelope",
      "kind": "requirement",
      "ownerId": "pkg-requirements",
      "reqId": "REQ-SYS-003",
      "priority": "high",
      "status": "approved",
      "text": "The spacecraft, in its stowed configuration, shall fit a 3U envelope of 100 mm × 100 mm × 340.5 mm. Deployed arrays are outside this check.",
      "envelope": {
        "x": 100,
        "y": 100,
        "z": 340.5,
        "unit": "mm"
      }
    },
    {
      "id": "req-sys-004",
      "name": "Pointing knowledge",
      "kind": "requirement",
      "ownerId": "pkg-requirements",
      "reqId": "REQ-SYS-004",
      "priority": "high",
      "status": "approved",
      "text": "The bus shall provide payload pointing knowledge of 0.5° (3σ) or better during imaging."
    },
    {
      "id": "req-sys-005",
      "name": "Downlink margin",
      "kind": "requirement",
      "ownerId": "pkg-requirements",
      "reqId": "REQ-SYS-005",
      "priority": "medium",
      "status": "approved",
      "text": "The S-band downlink shall close at 10° elevation with at least 3 dB of link margin."
    },
    {
      "id": "req-sys-006",
      "name": "Radiation tolerance",
      "kind": "requirement",
      "ownerId": "pkg-requirements",
      "reqId": "REQ-SYS-006",
      "priority": "high",
      "status": "draft",
      "text": "The bus shall survive a total ionizing dose of 5 krad behind 1 mm of aluminum without a functional failure."
    },
    {
      "id": "req-pwr-001",
      "name": "Generation floor",
      "kind": "requirement",
      "ownerId": "pkg-requirements",
      "reqId": "REQ-PWR-001",
      "priority": "high",
      "status": "approved",
      "text": "The power subsystem shall provide at least 7.0 W orbit-average generation so the 8.0 W consumption limit retains margin."
    },
    {
      "id": "req-adc-001",
      "name": "Attitude estimate",
      "kind": "requirement",
      "ownerId": "pkg-requirements",
      "reqId": "REQ-ADC-001",
      "priority": "high",
      "status": "approved",
      "text": "The ADCS shall estimate body attitude to within 0.2° (3σ)."
    },
    {
      "id": "req-com-001",
      "name": "EIRP",
      "kind": "requirement",
      "ownerId": "pkg-requirements",
      "reqId": "REQ-COM-001",
      "priority": "medium",
      "status": "draft",
      "text": "The communications subsystem shall radiate at least 2 dBW EIRP at 2.4 GHz."
    },
    {
      "id": "ctr-mass",
      "name": "Mass budget",
      "kind": "constraint",
      "ownerId": "pkg-constraints",
      "expression": "rollup(mass) <= 4.0 kg",
      "documentation": "Evaluated from part usages. The spacecraft block does not carry its own mass property."
    }
